set(fesa_required_sdks MKL HDF5)
if(BUILD_TESTING)
  list(APPEND fesa_required_sdks GTEST)
endif()
foreach(sdk IN LISTS fesa_required_sdks)
  set(FESA_${sdk}_ROOT "$ENV{FESA_${sdk}_ROOT}")
  if(NOT IS_DIRECTORY "${FESA_${sdk}_ROOT}")
    message(FATAL_ERROR "FESA_${sdk}_ROOT must name an installed SDK directory")
  endif()
endforeach()
foreach(entry IN ITEMS
    "${FESA_MKL_ROOT}/include/mkl.h"
    "${FESA_HDF5_ROOT}/include/hdf5.h")
  if(NOT EXISTS "${entry}")
    message(FATAL_ERROR "Required SDK file missing: ${entry}")
  endif()
endforeach()
if(BUILD_TESTING)
  if(NOT EXISTS "${FESA_GTEST_ROOT}/googletest/src/gtest-all.cc")
    message(FATAL_ERROR "Required GoogleTest source missing: googletest/src/gtest-all.cc")
  endif()
  execute_process(COMMAND git -C "${FESA_GTEST_ROOT}" rev-parse HEAD
    OUTPUT_VARIABLE gtest_revision OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE gtest_result)
  if(NOT gtest_result EQUAL 0 OR NOT gtest_revision STREQUAL
      "52eb8108c5bdec04579160ae17225d66034bd723")
    message(FATAL_ERROR "FESA_GTEST_ROOT must be GoogleTest v1.17.0 at pinned commit")
  endif()
endif()

set(FESA_OPENMP_ROOT "${FESA_MKL_ROOT}/../../compiler/latest")
set(FESA_MKL_LIBRARIES)
foreach(name IN ITEMS mkl_intel_lp64_dll mkl_intel_thread_dll mkl_core_dll)
  if(NOT EXISTS "${FESA_MKL_ROOT}/lib/${name}.lib")
    message(FATAL_ERROR "oneMKL LP64 DLL import library missing: ${name}")
  endif()
  list(APPEND FESA_MKL_LIBRARIES "${FESA_MKL_ROOT}/lib/${name}.lib")
endforeach()
if(NOT EXISTS "${FESA_OPENMP_ROOT}/lib/libiomp5md.lib")
  message(FATAL_ERROR "Intel OpenMP import library missing in sibling compiler package")
endif()
list(APPEND FESA_MKL_LIBRARIES "${FESA_OPENMP_ROOT}/lib/libiomp5md.lib")

if(NOT EXISTS "${FESA_HDF5_ROOT}/lib/hdf5.lib")
  message(FATAL_ERROR "HDF5 C DLL import library missing: hdf5.lib")
endif()
set(FESA_HDF5_LIBRARY "${FESA_HDF5_ROOT}/lib/hdf5.lib")
